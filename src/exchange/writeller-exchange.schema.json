{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:writeller:exchange:1.0.0",
  "title": "Writeller Exchange 1.0.0",
  "description": "Independent structural contract. Cross references, ownership, budgets, dates, images and hashes require semantic validation according to WRITELLER-EXCHANGE-SPEC.md.",
  "$comment": "Analysis artifact, not production application code. Unknown JSON is accepted only inside metadata, fields and namespaced extensions.",
  "type": "object",
  "properties": {
    "format": {
      "const": "writeller.exchange"
    },
    "version": {
      "const": "1.0.0"
    },
    "packageId": {
      "$ref": "#/$defs/id"
    },
    "exportedAt": {
      "$ref": "#/$defs/instant"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "scope": {
      "type": "object",
      "properties": {
        "projectId": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "const": "snapshot"
        }
      },
      "required": [
        "projectId",
        "mode"
      ],
      "additionalProperties": false
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      },
      "maxItems": 10000
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "maxItems": 10000
    },
    "catalogItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogItem"
      },
      "maxItems": 10000
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "maxItems": 10000
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      },
      "maxItems": 10000
    },
    "researchItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/researchItem"
      },
      "maxItems": 10000
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment"
      },
      "maxItems": 256
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "required": [
    "format",
    "version",
    "packageId",
    "exportedAt",
    "producer",
    "scope",
    "project",
    "chapters",
    "scenes",
    "catalogItems",
    "relationships",
    "notes",
    "researchItems",
    "attachments",
    "extensions"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "instant": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$(?![\\s\\S])",
      "format": "date-time"
    },
    "system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9.-]*$(?![\\s\\S])"
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "maxLength": 8388608
        },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "$ref": "#/$defs/jsonObject"
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$(?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "origin": {
      "type": "object",
      "properties": {
        "system": {
          "$ref": "#/$defs/system"
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        },
        "objectId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "system",
        "instanceId",
        "objectId"
      ],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "properties": {
        "system": {
          "$ref": "#/$defs/system"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "instanceId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "system",
        "version",
        "instanceId"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "collection": {
          "enum": [
            "project",
            "chapters",
            "scenes",
            "catalogItems",
            "relationships",
            "notes",
            "researchItems"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "collection",
        "id"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
