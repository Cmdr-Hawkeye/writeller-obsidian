          "maxLength": 100
        },
        "genreOrTopic": {
          "type": "string",
          "maxLength": 8388608
        },
        "languageCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "wordTarget": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "origin",
        "baseHash",
        "createdAt",
        "updatedAt",
        "metadata",
        "extensions",
        "title",
        "description",
        "projectType",
